# Copy this file to .env and fill in as each system gets set up.
# Nothing here is required to run Task 1 today -- any system left blank
# automatically falls back to its local synthetic CSV in data/, so you
# can keep developing/testing while setup for the others is in progress.

# --- Salesforce (CRM System) ---
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# --- EasyPost (Guaranteed Delivery System) ---
EASYPOST_API_KEY=

# --- Microsoft Graph / Outlook (Supplier Urgent Email System) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
